[
  {
    "description": "defaults keep Swiper's speed",
    "attributes": {},
    "expected": {
      "attributes": {
        "speed": 300
      },
      "navigation": false,
      "pagination": null,
      "notes": []
    }
  },
  {
    "description": "loop, arrows and bullets",
    "attributes": {
      "loop": true,
      "navigation": true,
      "pagination": true,
      "speed": 600,
      "align": "wide",
      "className": "is-hero"
    },
    "expected": {
      "attributes": {
        "align": "wide",
        "className": "is-hero",
        "type": "loop",
        "speed": 600
      },
      "navigation": true,
      "pagination": "dots",
      "notes": []
    }
  },
  {
    "description": "autoplay keeps Swiper's delay and hover behaviour",
    "attributes": {
      "autoplay": true
    },
    "expected": {
      "attributes": {
        "speed": 300,
        "autoplay": true,
        "interval": 3000,
        "pauseOnHover": false
      },
      "navigation": false,
      "pagination": null,
      "notes": []
    }
  },
  {
    "description": "layout settings; the height had no visible effect in Swiper",
    "attributes": {
      "perView": 3,
      "centerSlides": true,
      "freeMode": true,
      "rewind": true,
      "autoHeight": true,
      "spaceBetween": "24",
      "height": "50vh",
      "ariaLabel": "Example slider"
    },
    "expected": {
      "attributes": {
        "ariaLabel": "Example slider",
        "rewind": true,
        "autoHeight": true,
        "perPage": 3,
        "focusCenter": true,
        "freeDrag": true,
        "speed": 300,
        "gap": "24px"
      },
      "navigation": false,
      "pagination": null,
      "notes": [
        "height"
      ]
    }
  },
  {
    "description": "space between keeps the pixels Swiper read from the value",
    "attributes": {
      "spaceBetween": "1.5rem"
    },
    "expected": {
      "attributes": {
        "speed": 300,
        "gap": "1.5px"
      },
      "navigation": false,
      "pagination": null,
      "notes": []
    }
  },
  {
    "description": "an empty or zero space between adds no gap",
    "attributes": {
      "spaceBetween": "0px",
      "height": ""
    },
    "expected": {
      "attributes": {
        "speed": 300
      },
      "navigation": false,
      "pagination": null,
      "notes": []
    }
  },
  {
    "description": "width has no equivalent; hash navigation and the progress bar carry over",
    "attributes": {
      "width": "800",
      "hashNavigation": true,
      "pagination": true,
      "paginationType": "progressbar"
    },
    "expected": {
      "attributes": {
        "speed": 300,
        "hashNavigation": true
      },
      "navigation": false,
      "pagination": "progress",
      "notes": [
        "width"
      ]
    }
  },
  {
    "description": "fraction pagination becomes a counter",
    "attributes": {
      "pagination": true,
      "paginationType": "fraction"
    },
    "expected": {
      "attributes": {
        "speed": 300
      },
      "navigation": false,
      "pagination": "counter",
      "notes": []
    }
  },
  {
    "description": "an unknown pagination type becomes dots",
    "attributes": {
      "pagination": true,
      "paginationType": "custom"
    },
    "expected": {
      "attributes": {
        "speed": 300
      },
      "navigation": false,
      "pagination": "dots",
      "notes": [
        "paginationType"
      ]
    }
  }
]
