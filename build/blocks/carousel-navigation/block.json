{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "outstand/carousel-navigation",
  "version": "1.0.0",
  "title": "Carousel Navigation",
  "category": "design",
  "icon": "leftright",
  "ancestor": [
    "outstand/carousel"
  ],
  "description": "Previous and next buttons, plus a play/pause button when the carousel autoplays. Hidden when there is only one slide.",
  "textdomain": "outstand-carousel",
  "attributes": {
    "previousIcon": {
      "type": "string",
      "default": "core/arrow-left"
    },
    "nextIcon": {
      "type": "string",
      "default": "core/arrow-right"
    },
    "iconSize": {
      "type": "number",
      "default": 24
    }
  },
  "usesContext": [
    "outstand/carousel/autoplay",
    "outstand/carousel/slides"
  ],
  "supports": {
    "html": false,
    "reusable": false,
    "color": {
      "background": true,
      "text": true
    },
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "layout": {
      "allowSwitching": false,
      "allowInheriting": false,
      "allowVerticalAlignment": false,
      "default": {
        "type": "flex",
        "flexWrap": "nowrap",
        "justifyContent": "space-between"
      }
    },
    "interactivity": true
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}