{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "outstand/carousel-pagination",
  "version": "1.0.0",
  "title": "Carousel Pagination",
  "category": "design",
  "icon": "ellipsis",
  "ancestor": [
    "outstand/carousel"
  ],
  "description": "One button per slide, shown as dots or thumbnails, or a progress bar.",
  "textdomain": "outstand-carousel",
  "attributes": {
    "type": {
      "type": "string",
      "enum": [
        "dots",
        "thumbnails",
        "progress"
      ],
      "default": "dots"
    },
    "thumbnailSize": {
      "type": "string",
      "default": "thumbnail"
    }
  },
  "usesContext": [
    "outstand/carousel/slides"
  ],
  "supports": {
    "html": false,
    "reusable": false,
    "color": {
      "background": true,
      "text": true
    },
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "layout": {
      "allowSwitching": false,
      "allowInheriting": false,
      "default": {
        "type": "flex",
        "flexWrap": "wrap",
        "justifyContent": "center"
      }
    },
    "interactivity": true
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}